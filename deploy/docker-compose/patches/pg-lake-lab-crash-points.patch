+/* Lab image only; upstream production builds do not contain this GUC. */
+int			LakeLabCrashPointSetting = LAKE_LAB_CRASH_NONE;
+bool		LakeLabIcebergCommitPrepared = false;
+
+void
+LakeLabCrashIf(LakeLabCrashPoint point)
+{
+	if (LakeLabCrashPointSetting != point)
+		return;
+
+	LakeLabCrashPointSetting = LAKE_LAB_CRASH_NONE;
+	kill(MyProcPid, SIGKILL);
+	pg_unreachable();
+}

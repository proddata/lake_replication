FROM rust:1.85-bookworm@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY worker ./worker
RUN cargo test --locked --bin lake-replication-receiver --bin lake-replication-supervisor --bin lake-replication-initial-sync \
    && cargo build --release --locked --bin lake-replication-receiver --bin lake-replication-supervisor --bin lake-replication-initial-sync \
    && strip target/release/lake-replication-receiver target/release/lake-replication-supervisor target/release/lake-replication-initial-sync

ARG QUAL_IMAGE
FROM ${QUAL_IMAGE} AS patched
COPY worker /prototype/worker
COPY experiments/base_workers /prototype/experiment
RUN python3 /prototype/experiment/recovery.py /prototype

FROM rust:1.85-bookworm@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4 AS builder
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY --from=patched /prototype/worker ./worker
RUN cargo test --locked --bin lake-replication-supervisor \
    && cargo build --release --locked --bin lake-replication-supervisor \
    && strip target/release/lake-replication-supervisor

FROM ${QUAL_IMAGE}
COPY --from=builder /src/target/release/lake-replication-supervisor /usr/local/bin/lake-replication-supervisor

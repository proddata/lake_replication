# Upgrade-only overlay: leave the existing beta install scripts unregistered.
ARG QUAL_IMAGE
FROM ${QUAL_IMAGE}
USER root
COPY extensions/lake_replication /prototype/extensions/lake_replication
COPY migrations /prototype/migrations
COPY experiments/base_workers /prototype/experiment
RUN python3 /prototype/experiment/adapt.py /prototype --hardened \
    && make -C /prototype/extensions/lake_replication clean all install \
    && cp /prototype/experiment/register.sql \
       "$(pg_config --sharedir)/extension/lake_replication--0.1.0-beta.1--0.1.0-beta.2-prototype.sql"
